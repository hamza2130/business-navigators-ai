# Copy this file to .env and fill in real values. Never commit the real .env.

# ---- Database ----
# PostgreSQL with Row-Level Security tenant isolation - see schema.sql.
# Connect as app_user (created by schema.sql), NOT as the migration
# superuser: RLS does not apply to a table's owner or a superuser, so
# connecting as anything else silently disables tenant isolation.
DATABASE_URL=postgresql://app_user:change_me_in_production@127.0.0.1:5432/business_navigators
# Which tenant this app instance serves. Single-tenant today by design
# (SRS Phase 1) - schema.sql seeds a 'default' tenant matching this.
TENANT_ID=default

# ---- Job queue ----
# Inbound WhatsApp messages are enqueued here (see worker.py) instead of
# processed inline, so a message survives an app-process restart between
# being acked to Meta and actually being handled. Run the worker
# separately: `arq worker.WorkerSettings`.
REDIS_URL=redis://127.0.0.1:6379

# ---- AI / LLM ----
GROQ_API_KEY=your_groq_api_key

# ---- Meta WhatsApp Cloud API ----
WHATSAPP_TOKEN=your_meta_permanent_or_temporary_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
META_VERIFY_TOKEN=choose_a_long_random_string
META_API_VERSION=v20.0
# App secret from the Meta developer console (App Settings > Basic) - used
# to verify X-Hub-Signature-256 on every inbound webhook. Required: without
# it, the WhatsApp webhook refuses every request.
META_APP_SECRET=your_meta_app_secret

# Pre-approved WhatsApp Message Templates for the expiry-reminder cron job.
# Meta rejects free-form text sent outside the 24h customer-service window,
# which a scheduled reminder always is - these must be created and approved
# in Meta Business Manager first. Leave blank only for local development
# (the scheduler falls back to plain text, which will fail in production).
WHATSAPP_TEMPLATE_30D=
WHATSAPP_TEMPLATE_7D=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---- Email (Brevo) ----
BREVO_API_KEY=your_brevo_api_key
SENDER_EMAIL=your_email@domain.com
# Shared secret for the inbound email webhook - configure the same value as
# a custom header (or ?secret= query param) on the webhook URL in Brevo.
# Required: without it, /webhook/email refuses every request.
EMAIL_WEBHOOK_SECRET=choose_a_long_random_string

# ---- Calendar ----
BOOKING_LINK=https://calendar.app.google/...
GOOGLE_CREDENTIALS_FILE=credentials.json
# "primary" is the Google service account's OWN calendar, invisible to any
# human consultant unless explicitly shared. Set this to a calendar id the
# service account has been given write access to (Calendar Settings >
# Share with specific people > find the id under "Integrate calendar").
GOOGLE_CALENDAR_ID=primary

# ---- Admin dashboard / API ----
# Required on every /admin/* route, /test-scheduler, and the /dashboard UI
# (as ?key=... in the URL, or an X-Admin-Key header). Requests are refused
# entirely if this is left blank.
ADMIN_API_KEY=choose_a_long_random_string

# ---- OCR ----
# Only needed on Windows dev machines where the Tesseract installer doesn't
# add tesseract.exe to PATH. Leave unset in Docker/Linux - `apt install
# tesseract-ocr` already puts it on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- Document storage (S3) ----
# Real AWS S3 in production: leave S3_ENDPOINT_URL unset, set AWS_ACCESS_
# KEY_ID / AWS_SECRET_ACCESS_KEY (boto3 reads these directly - no app-
# specific setting needed) and pick an me-central-1 bucket for UAE data
# residency. Locally: point S3_ENDPOINT_URL at MinIO/LocalStack/moto_server
# instead - the application code is identical either way.
S3_BUCKET=business-navigators-documents
S3_REGION=me-central-1
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Signed document URLs expire after this many seconds (SRS: "short-lived
# signed URLs").
SIGNED_URL_TTL_SECONDS=900
